{
  "extends": "@backstage/cli/config/tsconfig.json",
  "include": [
    "packages/*/src",
    "packages/*/config.d.ts",
    "plugins/*/src",
    "plugins/*/config.d.ts",
    "plugins/*/dev",
    "plugins/*/migrations"
  ],
  "exclude": [
	  "node_modules",
	  "plugins/*-disabled",
	  "**/*.test.ts",
	  "**/*.test.tsx"
  	],
  "compilerOptions": {
    "outDir": "dist-types",
    "rootDir": ".",
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false

  }
}
